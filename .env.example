# Copy to .env and replace every value. .env is git-ignored; never commit it.
# Fresh random values for the secrets:  python -m anpr.security.keys
# The app refuses to start in production while any secret still contains "change-me".

# production | development | demo
APP_ENV=development

# --- PostgreSQL (docker compose reads these too) ---
POSTGRES_OWNER_PASSWORD=change-me
APP_DB_PASSWORD=change-me
# The API connects as the least-privilege role; migrations connect as the owner.
DATABASE_URL=postgresql+psycopg://anpr_app:change-me@127.0.0.1:5432/anpr
MIGRATION_DATABASE_URL=postgresql+psycopg://anpr_owner:change-me@127.0.0.1:5432/anpr
TEST_DATABASE_URL=postgresql+psycopg://anpr_owner:change-me@127.0.0.1:5432/anpr_test

# --- Secrets ---
JWT_SECRET=change-me-at-least-32-characters-long
# AES-256-GCM data keys, "key_id:base64(32 bytes)", comma separated. New data uses APP_ACTIVE_KEY_ID.
APP_DATA_KEYS=k1:change-me
APP_ACTIVE_KEY_ID=k1
# Ed25519 private key that signs audit entries, base64 of the raw 32 bytes.
AUDIT_SIGNING_KEY=change-me
# SHA-256 (hex) of the token the detection service sends. Only the hash lives on the server.
DETECTION_TOKEN_SHA256=change-me

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173
# true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Limits (defaults shown) ---
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# AUTH_RATE_PER_MINUTE=10
# DETECTION_RATE_PER_MINUTE=600
# MAX_BODY_BYTES=1000000
# MAX_CSV_BYTES=2000000
# MAX_CSV_ROWS=10000
# CAMERA_RATE_PER_MINUTE=120
# LIVE_FRAME_RATE_PER_MINUTE=240
# EVIDENCE_DIR=var/evidence

# --- Camera connection tests ---
# test-connection refuses loopback, link-local and cloud-metadata addresses. List CIDR ranges here
# only to allow one of them on purpose (e.g. a camera simulator on 127.0.0.1/32 during development).
# ALLOWED_CAMERA_NETWORKS=

# --- Dashboard (dashboard/.env.local) ---
# VITE_API_BASE_URL=http://localhost:8000
# VITE_APP_ENV=development        # demo = in-browser fictional data, with a DEMO DATA ribbon
# VITE_MAP_TILE_URL=              # your own tile server, e.g. http://localhost:8080/tiles/{z}/{x}/{y}.png
